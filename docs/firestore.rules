rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /mocidade/{hymnId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /harpa/{hymnId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /calendarEvents/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /quizScores/{scoreId} {
      allow read: if true;
      allow create, update: if request.resource.data.quizId == 'licoes-1-11'
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 55
        && request.resource.data.correctAnswers is int
        && request.resource.data.correctAnswers >= 0
        && request.resource.data.correctAnswers <= 11;
      allow delete: if isAdmin();
    }
  }
}
